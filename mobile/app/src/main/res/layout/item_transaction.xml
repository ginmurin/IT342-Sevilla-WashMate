<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Transaction Icon Indicator -->
    <View
        android:id="@+id/vIndicator"
        android:layout_width="8dp"
        android:layout_height="32dp"
        android:background="#10B981"
        android:layout_marginEnd="12dp" />

    <!-- Info Block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wallet Top-Up"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-05-19 18:05"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Amount and Status Block -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ ₱500.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#10B981"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPLETED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0D9488"
            android:background="#E0F2FE"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
