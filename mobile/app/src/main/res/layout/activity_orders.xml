<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Orders"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track and manage your laundry orders"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Orders Yet"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="When you place a laundry order, it will show up here."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCreateFirstOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place Your First Order"
            android:backgroundTint="#0D9488"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"/>
    </LinearLayout>

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="#0D9488"
        android:visibility="visible"/>

    <!-- Orders List -->
    <ScrollView
        android:id="@+id/scrollViewOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeader"
        android:layout_above="@id/bottomNavigation"
        android:padding="12dp"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llOrdersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#0D9488"
        app:itemTextColor="#0D9488" />
</RelativeLayout>
