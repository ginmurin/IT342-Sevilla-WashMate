<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Type indicator circle -->
        <View
            android:id="@+id/vIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@android:drawable/presence_online"
            android:backgroundTint="#0D9488"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Successful"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>

            <TextView
                android:id="@+id/tvNotificationMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your payment of Php 250 for Order #WM-1002 has been processed."
                android:textSize="13sp"
                android:textColor="#475569"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just now"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnMarkRead"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Read"
            android:textSize="11sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#0D9488"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
