<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when radio button is selected -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="#F0FDFA" /> <!-- Teal 50 -->
            <stroke
                android:width="2dp"
                android:color="#0D9488" /> <!-- Teal 600 -->
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Default state -->
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#E2E8F0" /> <!-- Slate 200 -->
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
